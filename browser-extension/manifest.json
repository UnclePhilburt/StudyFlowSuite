{
  "manifest_version": 3,
  "name": "StudyFlow AI Tutor",
  "version": "1.0.0",
  "description": "Legal AI tutoring tool - Shows step-by-step explanations to help you understand quiz concepts",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://studyflowsuite.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup-tutor.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tutor-sidebar.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["error.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
