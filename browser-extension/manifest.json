{
  "manifest_version": 3,
  "name": "StudyFlow NoteFlow",
  "version": "2.2.0",
  "description": "Search your uploaded notes with AI - Get hints and guidance without direct answers",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://studyflowsuite.onrender.com/*"
  ],
  "background": {
    "service_worker": "background-noteflow.js"
  },
  "action": {
    "default_popup": "popup-tutor.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["noteflow-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["error.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
